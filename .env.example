# Google Places API key (required — enable "Places API (New)" in Google Cloud Console)
GOOGLE_PLACES_API_KEY=your_google_api_key_here

# Database (used by docker-compose; override if running Postgres externally)
DATABASE_URL=postgresql+psycopg://modemap:modemap@localhost:5433/modemap

# Redis (used by docker-compose; override if running Redis externally)
REDIS_URL=redis://localhost:6379/0

# Environment
ENV=dev
